{
  "name": "guchi-bbs",
  "main": "worker.js",
  "compatibility_date": "2026-08-30",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guchi-bbs-db",
      "database_id": "ここは今入っているUUIDのまま"
    }
  ]
}
